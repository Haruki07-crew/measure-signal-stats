# このファイルを .env にコピーして、自分の値に書き換える（.env は Git に入れない）
#   cp .env.example .env && chmod 600 .env
# Pi・Azure の VM では /etc/labnote/labnote.env に置く（docs/pi.md）

# Discord の開発者ポータルの Bot の画面で作るトークン（実物をここ以外に書かない）
DISCORD_TOKEN=your-discord-bot-token

# 記録の置き場所（notes/・data/・labnote.db）。Mac の例：~/home-lab/labnote
LABNOTE_HOME=~/home-lab/labnote

# 許可リスト（カンマ区切りの数字の ID）。3つとも合うときだけ bot が答える。空なら誰にも答えない
# ID は Discord の「開発者モード」をオンにして、右クリック →「ID をコピー」（画面の項目名は要確認）
LABNOTE_GUILD_IDS=111111111111111111
LABNOTE_CHANNEL_IDS=222222222222222222
LABNOTE_USER_IDS=333333333333333333

# bot が受け取るファイルの上限（バイト）と種類
LABNOTE_MAX_BYTES=8000000
LABNOTE_ALLOWED_EXT=.csv,.png,.json,.jpg,.jpeg,.txt

# 日付の区切りに使うタイムゾーン
LABNOTE_TZ=Asia/Tokyo

# labnote-send が使う Discord の Webhook の URL（これも秘密情報。漏れたら作り直す）
LABNOTE_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# （任意）Webhook で送られた添付を bot が自動で取り込むときだけ、その Webhook の ID を書く。
# 書くと Message Content Intent が必要になる（docs/discord_setup.md）。空なら使わない
LABNOTE_INGEST_WEBHOOK_IDS=
